<?xml version="1.0" encoding="utf-8"?>
<!-- Signal Play mark (Claude Design "EliteStream Logo" 3a) as a vector drawable. Solid colours stand in
     for the gradient because vector gradients need Android 7.0; production artwork: brand designer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="#080C18"
        android:pathData="M0,0 L100,0 L100,100 L0,100 Z" />
    <path
        android:fillColor="@color/markBlue"
        android:strokeColor="@color/markBlue"
        android:strokeWidth="8"
        android:strokeLineJoin="round"
        android:pathData="M20,24 L20,76 L58,50 Z" />
    <path
        android:strokeColor="@color/markLight"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M67.9,40.1 A14,14 0 0,1 67.9,59.9" />
    <path
        android:strokeColor="@color/markCyan"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M76.4,31.6 A26,26 0 0,1 76.4,68.4" />
</vector>
